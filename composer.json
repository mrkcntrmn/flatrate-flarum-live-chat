{
    "name": "flatrate/flarum-live-chat",
    "description": "FlatRate.wiki-owned hardened realtime live chat for Flarum (derived from Neon Chat / Xelson).",
    "keywords": [
        "chat",
        "flarum",
        "flatrate",
        "live-chat",
        "xelson",
        "push-edx",
        "neon-chat"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mrkcntrmn/flatrate-flarum-live-chat/issues",
        "source": "https://github.com/mrkcntrmn/flatrate-flarum-live-chat"
    },
    "authors": [
        {
            "name": "Juan"
        },
        {
            "name": "Guillem Pascual",
            "email": "blipi.tube@gmail.com",
            "homepage": "http://pushedx.net"
        },
        {
            "name": "Xelson",
            "homepage": "https://neonsky.ru"
        },
        {
            "name": "FlatRate.wiki",
            "homepage": "https://flatrate.wiki"
        }
    ],
    "require": {
        "flarum/core": "^1.8.5",
        "flarum/markdown": "^1.0",
        "php": "^8.1",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "conflict": {
        "xelson/flarum-ext-chat": "*"
    },
    "autoload": {
        "psr-4": {
            "FlatRate\\LiveChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatRate\\LiveChat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "flarum-extension": {
            "title": "FlatRate Live Chat",
            "category": "feature",
            "icon": {
                "image": "icon.svg",
                "backgroundColor": "#1f2937",
                "backgroundSize": "cover",
                "backgroundPosition": "center"
            }
        }
    },
    "homepage": "https://github.com/mrkcntrmn/flatrate-flarum-live-chat"
}
